      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516368127,
      "link": null,
      "locked": false,
      "text": "- 3 souls from coffers\nto move the sigil of\ngreed.\n- 2 souls from coffers\nto discard 1 agent\nfrom economy\ncontracting track.\n- 4 souls from coffers\nto take 1 soul from\nlimbo to reserves.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "- 3 souls from coffers to move the sigil of greed.\n- 2 souls from coffers to discard 1 agent from economy contracting track.\n- 4 souls from coffers to take 1 soul from limbo to reserves.",
      "autoResize": false,
      "lineHeight": 1.25
    },
