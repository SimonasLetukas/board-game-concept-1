    {
      "id": "ohgSAGw-L3QbD6069reOq",
      "type": "text",
      "x": 3720,
      "y": 1920,
      "width": 443.0296968419368,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3Y",
      "roundness": null,
      "seed": 1885396317,
      "version": 173,
      "versionNonce": 621868142,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780852277372,
      "link": null,
      "locked": false,
      "text": "In auction order (determined by the logistics\ncareer branch) each player may buy 1 card\nfrom the auction. The price is determined by\nthe bidding level (more expensive closer to\nthe deck), and can be modified by the card\nitself and any tax or discount tokens next\nto the auction track. When the card is\nbought, it is added to the player's deck, and\nthat auction track is refreshed. \n\nRefreshing the auction track is done in two\nsteps: all cards are shifted away from the\ndeck, to the cheapest possible empty space.\nThen starting from the cheapest possible\nempty space, each space is filled with a new\nagent card from the top of the deck. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In auction order (determined by the logistics career branch) each player may buy 1 card from the auction. The price is determined by the bidding level (more expensive closer to the deck), and can be modified by the card itself and any tax or discount tokens next to the auction track. When the card is bought, it is added to the player's deck, and that auction track is refreshed. \n\nRefreshing the auction track is done in two steps: all cards are shifted away from the deck, to the cheapest possible empty space. Then starting from the cheapest possible empty space, each space is filled with a new agent card from the top of the deck. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
